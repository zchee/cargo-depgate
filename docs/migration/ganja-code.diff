+++ b/depgate.toml
@@ -0,0 +1,52 @@
+# Dependency policy for zchee/ganja-code, replacing the nineteen shell gates
+# that stood at .github/workflows/ci.yaml L176-355 as of commit 153bfb1.
+#
+# 7 internal + 5 deny + 3 leaf + 2 direct + 1 sealed + 1 manifest = 19 rules.
+# The rule-id <-> retired-line mapping is the review baseline in
+# docs/migration/ganja-code.md of zchee/cargo-depgate; read it before editing.
+schema = 1
+
+[manifest]
+versions-in-root = true
+
+[rules."ganja-core"]
+deny = ["ratatui*", "axum*"]
+internal = ["ganja-permission", "ganja-protocol", "ganja-provider", "ganja-storage", "ganja-team", "ganja-tool"]
+
+[rules."ganja-tool"]
+internal = ["ganja-permission"]
+
+[rules."ganja-team"]
+internal = ["ganja-protocol"]
+
+[rules."ganja-provider"]
+deny = ["ratatui*", "crossterm*", "arboard*"]
+internal = ["ganja-permission", "ganja-protocol", "ganja-tool"]
+
+[rules."ganja-permission"]
+leaf = true
+
+[rules."ganja-protocol"]
+leaf = true
+direct = ["serde", "serde_json", "uuid"]
+
+[rules."ganja-storage"]
+internal = ["ganja-permission", "ganja-protocol"]
+
+[rules."ganja-client"]
+deny = ["axum*"]
+internal = ["ganja-protocol"]
+
+[rules."ganja-teammate-local"]
+internal = ["ganja-core", "ganja-permission", "ganja-protocol", "ganja-provider", "ganja-storage", "ganja-team", "ganja-tool"]
+
+[rules."ganja-tui"]
+deny = ["axum*"]
+
+[rules."ganja-serve"]
+deny = ["ratatui*", "ganja-teammate-local"]
+
+[rules.tmux]
+leaf = true
+sealed = true
+direct = ["futures", "thiserror", "tokio"]
